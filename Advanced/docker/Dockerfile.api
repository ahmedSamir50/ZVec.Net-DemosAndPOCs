FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props ./
COPY src/PDDM.Shared/PDDM.Shared.csproj src/PDDM.Shared/
COPY src/PDDM.Core/PDDM.Core.csproj src/PDDM.Core/
COPY src/PDDM.Api/PDDM.Api.csproj src/PDDM.Api/
RUN dotnet restore src/PDDM.Api/PDDM.Api.csproj
COPY src/PDDM.Shared/ src/PDDM.Shared/
COPY src/PDDM.Core/ src/PDDM.Core/
COPY src/PDDM.Api/ src/PDDM.Api/
RUN dotnet publish src/PDDM.Api/PDDM.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "PDDM.Api.dll"]
