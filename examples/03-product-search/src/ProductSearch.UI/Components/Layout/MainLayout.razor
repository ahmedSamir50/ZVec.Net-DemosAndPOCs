@inherits LayoutComponentBase

<div class="min-h-screen bg-base-100 zlens-app">
    <header class="navbar zlens-header bg-base-100/90 border-b border-base-300 backdrop-blur sticky top-0 z-30 px-4 lg:px-6">
        <div class="flex-1 min-w-0">
            <a href="/search" class="inline-flex min-w-0">
                <ZLensBrand ShowBadge="true" />
            </a>
        </div>
        <div class="flex-none flex items-center gap-2 lg:gap-3">
            <a href="/status" class="btn btn-ghost btn-circle btn-sm lg:btn-md" title="Status &amp; settings">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 lg:h-6 lg:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </a>
            <ModelHud />
            @if (_demoReady)
            {
                <span class="badge badge-success badge-outline badge-sm lg:badge-md hidden sm:inline-flex glow-ready">Demo ready</span>
            }
        </div>
    </header>

    <nav class="dock-nav">
        <NavLink href="/search" class="dock-link" Match="NavLinkMatch.Prefix" title="Search">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
            <span class="dock-label">Search</span>
        </NavLink>
        <NavLink href="/ingest" class="dock-link" title="Ingest">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" /></svg>
            <span class="dock-label">Ingest</span>
        </NavLink>
        <NavLink href="/status" class="dock-link" title="Status">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            <span class="dock-label">Status</span>
        </NavLink>
    </nav>

    <main class="main-with-dock pb-20 md:pb-4">
        @Body
    </main>

    <ToastHost />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>
