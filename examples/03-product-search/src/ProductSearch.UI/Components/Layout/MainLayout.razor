@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="fashion-layout">
    <MudAppBar Elevation="0" Class="fashion-appbar" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="fashion-brand">ProductSearch</MudText>
        <MudText Typo="Typo.caption" Class="ml-2 fashion-tagline">SigLIP · ZVec · pgvector</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="fashion-drawer" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="/search" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Search">Search</MudNavLink>
            <MudNavLink Href="/ingest" Icon="@Icons.Material.Filled.CloudDownload">Ingest</MudNavLink>
            <MudNavLink Href="/status" Icon="@Icons.Material.Filled.Analytics">Status</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="fashion-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#E8B4B8",
            Secondary = "#C9A96E",
            AppbarBackground = "#0A0A0A",
            Background = "#0A0A0A",
            Surface = "#141414",
            DrawerBackground = "#111111",
            TextPrimary = "#F5F0EB",
            TextSecondary = "#A89F94",
            ActionDefault = "#C9A96E"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Cormorant Garamond", "Georgia", "serif"]
            },
            H4 = new H4Typography { FontFamily = ["Cormorant Garamond", "Georgia", "serif"] },
            H6 = new H6Typography { FontFamily = ["Cormorant Garamond", "Georgia", "serif"] },
            Button = new ButtonTypography { FontFamily = ["Inter", "Segoe UI", "sans-serif"] },
            Body1 = new Body1Typography { FontFamily = ["Inter", "Segoe UI", "sans-serif"] },
            Body2 = new Body2Typography { FontFamily = ["Inter", "Segoe UI", "sans-serif"] }
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
