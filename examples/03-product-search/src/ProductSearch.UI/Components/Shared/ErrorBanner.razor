@if (!string.IsNullOrWhiteSpace(Message))
{
    <div role="alert" class="alert alert-error rounded-2xl @CssClass">
        <div class="w-full">
            <p class="font-semibold text-sm">@Title</p>
            <p class="text-sm mt-1">@Message</p>
            @if (OnRetry.HasDelegate)
            {
                <button type="button" class="btn btn-error btn-sm mt-3" disabled="@RetryDisabled" @onclick="OnRetry">@RetryLabel</button>
            }
        </div>
    </div>
}
