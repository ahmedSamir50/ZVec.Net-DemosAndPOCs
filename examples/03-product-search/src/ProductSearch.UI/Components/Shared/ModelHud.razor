@if (_apiUnreachable)
{
    <span class="badge badge-error badge-sm shrink-0">API unreachable</span>
    <button type="button" class="btn btn-error btn-xs shrink-0" @onclick="RetryAsync">Retry</button>
}
else if (_boot is not null)
{
    <div class="flex items-center gap-2 min-w-0">
        @if (_boot.State is "Ready")
        {
            <span class="badge badge-success badge-sm gap-1 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-success-content"></span>
                SigLIP ready
            </span>
        }
        else if (_boot.State is "Failed")
        {
            <span class="badge badge-error badge-sm shrink-0">Model failed</span>
            <button type="button" class="btn btn-error btn-xs shrink-0" disabled="@_retrying" @onclick="RetryAsync">
                @(_retrying ? "Retrying…" : "Retry")
            </button>
        }
        else
        {
            <span class="badge badge-info badge-sm shrink-0">@HudLabel()</span>
            @if (_boot.OverallPercent is not null)
            {
                <progress class="progress progress-primary w-24 sm:w-32 h-2" value="@_boot.OverallPercent" max="100"></progress>
                <span class="text-xs text-base-content/60 tabular-nums shrink-0">@($"{_boot.OverallPercent:0.#}%")</span>
            }
            else
            {
                <span class="loading loading-spinner loading-xs text-primary"></span>
            }
        }
    </div>
}
