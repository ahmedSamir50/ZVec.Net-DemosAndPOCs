<div class="flex items-center gap-3 lg:gap-4 min-w-0 @CssClass">
    <img src="zlens-logo.svg" alt="" class="w-10 h-10 lg:w-12 lg:h-12 xl:w-14 xl:h-14 shrink-0 rounded-[11px] lg:rounded-[13px]" />
    <div class="flex items-center gap-2.5 lg:gap-3 min-w-0">
        <span class="text-xl lg:text-2xl xl:text-3xl font-bold tracking-tight text-base-content truncate">ZLens</span>
        @if (ShowBadge)
        {
            <span class="inline-flex items-center rounded-full bg-[#2563EB] px-2.5 py-0.5 lg:px-3 lg:py-1 text-[11px] lg:text-xs font-semibold text-white shrink-0">.NET 10</span>
        }
    </div>
</div>
