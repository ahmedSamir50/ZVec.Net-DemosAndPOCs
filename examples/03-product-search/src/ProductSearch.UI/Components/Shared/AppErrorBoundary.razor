@inherits ErrorBoundary

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="px-4 py-6 max-w-3xl mx-auto">
        <ErrorBanner Title="Unhandled error" Message="@CurrentException.Message" RetryLabel="Dismiss" OnRetry="RecoverClicked" />
        <pre class="mt-3 p-3 rounded-xl bg-base-200 text-xs whitespace-pre-wrap overflow-x-auto opacity-80">@CurrentException</pre>
    </div>
}
