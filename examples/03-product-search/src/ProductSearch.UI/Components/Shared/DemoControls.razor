@using ProductSearch.Shared.Enums

<div class="grid gap-4">
    <div class="flex flex-wrap gap-3 items-end">
        <label class="form-control w-full sm:w-auto">
            <span class="label-text text-xs mb-1">Engine</span>
            <select class="select select-bordered select-sm"
                    @bind="Engine"
                    @bind:after="() => EngineChanged.InvokeAsync(Engine)">
                @foreach (var mode in Enum.GetValues<VectorEngineMode>())
                {
                    <option value="@mode">@mode</option>
                }
            </select>
        </label>

        <label class="form-control w-full sm:w-auto">
            <span class="label-text text-xs mb-1">Results</span>
            <select class="select select-bordered select-sm"
                    @bind="TopK"
                    @bind:after="() => TopKChanged.InvokeAsync(TopK)">
                <option value="3">3</option>
                <option value="5">5</option>
                <option value="10">10</option>
            </select>
        </label>

        @if (ShowFusion)
        {
            <label class="form-control w-full sm:w-auto">
                <span class="label-text text-xs mb-1">Fusion</span>
                <select class="select select-bordered select-sm"
                        @bind="Fusion"
                        @bind:after="() => FusionChanged.InvokeAsync(Fusion)">
                    @foreach (var mode in Enum.GetValues<FusionMode>())
                    {
                        <option value="@mode">@mode</option>
                    }
                </select>
            </label>
        }
    </div>

    <div class="flex flex-wrap gap-3">
        <label class="form-control w-full sm:w-36">
            <span class="label-text text-xs mb-1">Gender</span>
            <select class="select select-bordered select-sm"
                    @bind="Gender"
                    @bind:after="() => GenderChanged.InvokeAsync(Gender)">
                <option value="">Any</option>
                @foreach (var g in Genders)
                {
                    <option value="@g">@g</option>
                }
            </select>
        </label>
        <label class="form-control w-full sm:w-36">
            <span class="label-text text-xs mb-1">Colour</span>
            <select class="select select-bordered select-sm"
                    @bind="BaseColour"
                    @bind:after="() => BaseColourChanged.InvokeAsync(BaseColour)">
                <option value="">Any</option>
                @foreach (var c in Colours)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </label>
        <label class="form-control w-full sm:w-36">
            <span class="label-text text-xs mb-1">Season</span>
            <select class="select select-bordered select-sm"
                    @bind="Season"
                    @bind:after="() => SeasonChanged.InvokeAsync(Season)">
                <option value="">Any</option>
                @foreach (var s in Seasons)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </label>
        <label class="form-control w-full sm:w-36">
            <span class="label-text text-xs mb-1">Usage</span>
            <select class="select select-bordered select-sm"
                    @bind="Usage"
                    @bind:after="() => UsageChanged.InvokeAsync(Usage)">
                <option value="">Any</option>
                @foreach (var u in Usages)
                {
                    <option value="@u">@u</option>
                }
            </select>
        </label>
    </div>

    <div class="flex flex-wrap gap-4">
        <label class="label cursor-pointer gap-2 justify-start">
            <input type="checkbox"
                   class="toggle toggle-sm toggle-primary"
                   @bind="UseInvert"
                   @bind:after="() => UseInvertChanged.InvokeAsync(UseInvert)" />
            <span class="label-text text-xs">Invert filters</span>
        </label>
        <label class="label cursor-pointer gap-2 justify-start">
            <input type="checkbox"
                   class="toggle toggle-sm toggle-primary"
                   @bind="UseHybridFts"
                   @bind:after="() => UseHybridFtsChanged.InvokeAsync(UseHybridFts)" />
            <span class="label-text text-xs">Hybrid FTS</span>
        </label>
    </div>
</div>

@code {
    [Parameter] public VectorEngineMode Engine { get; set; }
    [Parameter] public EventCallback<VectorEngineMode> EngineChanged { get; set; }

    [Parameter] public int TopK { get; set; }
    [Parameter] public EventCallback<int> TopKChanged { get; set; }

    [Parameter] public FusionMode Fusion { get; set; }
    [Parameter] public EventCallback<FusionMode> FusionChanged { get; set; }

    [Parameter] public string? Gender { get; set; }
    [Parameter] public EventCallback<string?> GenderChanged { get; set; }

    [Parameter] public string? BaseColour { get; set; }
    [Parameter] public EventCallback<string?> BaseColourChanged { get; set; }

    [Parameter] public string? Season { get; set; }
    [Parameter] public EventCallback<string?> SeasonChanged { get; set; }

    [Parameter] public string? Usage { get; set; }
    [Parameter] public EventCallback<string?> UsageChanged { get; set; }

    [Parameter] public bool UseInvert { get; set; }
    [Parameter] public EventCallback<bool> UseInvertChanged { get; set; }

    [Parameter] public bool UseHybridFts { get; set; }
    [Parameter] public EventCallback<bool> UseHybridFtsChanged { get; set; }

    [Parameter] public bool ShowFusion { get; set; }

    private static readonly string[] Genders = ["Men", "Women", "Unisex", "Boys", "Girls"];
    private static readonly string[] Colours = ["Blue", "Black", "White", "Red", "Green", "Brown", "Grey", "Pink", "Navy Blue"];
    private static readonly string[] Seasons = ["Summer", "Winter", "Fall", "Spring"];
    private static readonly string[] Usages = ["Casual", "Formal", "Sports", "Ethnic", "Smart Casual", "Travel"];
}
