@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="ingest-shader-layer" aria-hidden="true" style="position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden">
    <canvas @ref="_canvas" class="ingest-shader-canvas" style="display:block;width:100%;height:100%"></canvas>
</div>

@code {
    private ElementReference _canvas;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            try
            {
                await Js.InvokeVoidAsync("productSearchIngestShader.init", _canvas);
            }
            catch
            {
                // WebGL unavailable — decorative only.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("productSearchIngestShader.dispose");
        }
        catch
        {
            // ignore teardown errors
        }
    }
}
