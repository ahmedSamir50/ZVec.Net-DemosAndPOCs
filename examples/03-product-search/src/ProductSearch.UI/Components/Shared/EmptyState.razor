<div class="zlens-empty rounded-2xl border border-base-300 bg-base-200/60 p-8 text-center @CssClass">
    <div class="text-4xl mb-3 opacity-70">@Icon</div>
    <h2 class="text-lg font-semibold">@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="text-sm text-base-content/60 mt-2 max-w-md mx-auto">@Message</p>
    }
    @if (ChildContent is not null)
    {
        <div class="mt-5 flex flex-wrap justify-center gap-2">
            @ChildContent
        </div>
    }
</div>
