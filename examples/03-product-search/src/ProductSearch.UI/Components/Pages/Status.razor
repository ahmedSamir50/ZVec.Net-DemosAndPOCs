@page "/status"
@rendermode InteractiveServer

<div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="page-title">Status</h1>
            <p class="page-subtitle">Catalog counts, Postgres, SigLIP bootstrap, and maintenance.</p>
        </div>
        <button type="button" class="btn btn-outline btn-sm" disabled="@_loading" @onclick="RefreshAsync">Refresh</button>
    </div>

    @if (_loadError is not null && _status is null)
    {
        <ErrorBanner Title="Could not load status"
                     Message="@_loadError"
                     RetryLabel="Retry"
                     OnRetry="RefreshAsync"
                     RetryDisabled="@_loading" />
    }
    else if (_loading && _status is null)
    {
        <BusyBlock Visible="true" Message="Connecting to API…" />
    }
    else if (_status is not null)
    {
        @if (_status.DemoReady)
        {
            <div class="alert alert-success rounded-2xl">
                <span>Demo ready — SQL and ZVec counts are aligned.</span>
            </div>
        }

        @if (_status.Postgres is not null)
        {
            <div class="card bg-base-200 border border-base-300 rounded-2xl">
                <div class="card-body gap-3">
                    <h2 class="card-title text-base">PostgreSQL</h2>
                    <p class="text-xs text-base-content/60">Persistent Docker volume <code class="font-mono">@_status.Postgres.VolumeName</code></p>
                    <div class="grid sm:grid-cols-2 gap-3 text-sm">
                        <div><span class="text-base-content/50">Host</span><div class="font-mono">@_status.Postgres.Host</div></div>
                        <div><span class="text-base-content/50">Port</span><div class="font-mono">@_status.Postgres.Port</div></div>
                        <div><span class="text-base-content/50">Database</span><div class="font-mono">@_status.Postgres.Database</div></div>
                        <div><span class="text-base-content/50">Username</span><div class="font-mono">@_status.Postgres.Username</div></div>
                        <div class="sm:col-span-2"><span class="text-base-content/50">Password</span><div class="font-mono select-all">@_status.Postgres.Password</div></div>
                    </div>
                </div>
            </div>
        }

        <div class="grid sm:grid-cols-3 gap-4">
            <div class="stat-card">
                <p class="stat-label">Postgres</p>
                <p class="stat-value">@_status.PostgresCount</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">ZVec text</p>
                <p class="stat-value">@_status.ZVecTextCount</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">ZVec image</p>
                <p class="stat-value">@_status.ZVecImageCount</p>
            </div>
        </div>

        @if (_status.Runtime is not null)
        {
            <RuntimeSnapshotPanel Snapshot="_status.Runtime" />
        }

        @if (_status.ModelBootstrap is not null)
        {
            <div class="card bg-base-200 border border-base-300 rounded-2xl">
                <div class="card-body gap-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 class="card-title text-base">SigLIP bootstrap</h2>
                            <p class="text-sm text-base-content/60">@_status.ModelBootstrap.Message</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="badge @BootstrapBadgeClass(_status.ModelBootstrap.State)">@_status.ModelBootstrap.State</span>
                            @if (_status.ModelBootstrap.State is "Failed")
                            {
                                <button type="button" class="btn btn-error btn-sm" disabled="@_retryBusy" @onclick="RetryModelAsync">
                                    @(_retryBusy ? "Retrying…" : "Retry download")
                                </button>
                            }
                        </div>
                    </div>

                    @if (_status.ModelBootstrap.OverallPercent is not null &&
                         _status.ModelBootstrap.State is not ("Ready" or "Failed"))
                    {
                        <BusyBlock Visible="true"
                                   Message="Downloading SigLIP…"
                                   SubMessage="@($"{_status.ModelBootstrap.OverallPercent:0.#}%")"
                                   CssClass="py-4" />
                        <progress class="progress progress-primary w-full" value="@_status.ModelBootstrap.OverallPercent" max="100"></progress>
                    }

                    @if (_status.ModelBootstrap.Files.Count > 0)
                    {
                        <div class="overflow-x-auto">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>File</th>
                                        <th>Status</th>
                                        <th>On disk</th>
                                        <th>Bytes</th>
                                        <th>%</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in _status.ModelBootstrap.Files)
                                    {
                                        <tr>
                                            <td class="font-mono text-xs">
                                                <div>@file.Name</div>
                                                @if (!string.IsNullOrEmpty(file.FullPath))
                                                {
                                                    <code class="text-[10px] text-base-content/50 break-all select-all">@file.FullPath</code>
                                                }
                                            </td>
                                            <td><span class="badge badge-ghost badge-sm">@file.Status</span></td>
                                            <td class="text-xs">@(file.OnDisk ? "Yes" : "No")</td>
                                            <td class="text-xs tabular-nums">@FormatBytes(file.BytesReceived, file.BytesTotal)</td>
                                            <td class="text-xs tabular-nums">@(file.Percent is null ? "—" : $"{file.Percent:0.#}%")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_status.ModelBootstrap.Error))
                    {
                        <ErrorBanner Title="@_status.ModelBootstrap.Error"
                                     Message="@_status.ModelBootstrap.ErrorDetail"
                                     RetryLabel="Retry download"
                                     OnRetry="RetryModelAsync"
                                     RetryDisabled="@_retryBusy" />
                    }

                    @if (!string.IsNullOrEmpty(_status.ModelBootstrap.ModelsDir))
                    {
                        <p class="text-xs text-base-content/50">
                            Models directory:
                            <code class="font-mono break-all select-all">@_status.ModelBootstrap.ModelsDir</code>
                        </p>
                    }
                </div>
            </div>
        }

        <div class="card bg-base-200 border border-base-300 rounded-2xl">
            <div class="card-body">
                <h2 class="card-title text-base mb-2">Demo readiness</h2>
                <div class="overflow-x-auto">
                    <table class="table table-sm">
                        <tbody>
                            <tr><td>Demo ready</td><td>@(_status.DemoReady ? "Yes" : "No")</td></tr>
                            <tr><td>Model</td><td>@_status.ActiveModelId (@_status.EmbeddingDim dim)</td></tr>
                            <tr><td>Stamp match</td><td>@(_status.StampMatch ? "Yes" : "No")</td></tr>
                            <tr><td>Ingest offset</td><td>@_status.IngestOffset / @_status.CatalogTotal</td></tr>
                            <tr><td>Encoder ready</td><td>@(_status.ModelBootstrapComplete ? "Yes" : "No")</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_status.StampWarning))
        {
            <div role="alert" class="alert alert-warning rounded-2xl"><span>@_status.StampWarning</span></div>
        }
        @if (!string.IsNullOrEmpty(_status.IndexWarning))
        {
            <div role="alert" class="alert alert-info rounded-2xl"><span>@_status.IndexWarning</span></div>
        }

        @if (_status.IngestOffset <= 0)
        {
            <EmptyState Icon="📦"
                        Title="Indexes empty"
                        Message="Run ingest before searching."
                        CssClass="border-dashed">
                <a href="/ingest" class="btn btn-primary btn-sm">Start ingest</a>
            </EmptyState>
        }

        <div class="card bg-base-200 border border-base-300 rounded-2xl">
            <div class="card-body gap-4">
                <h2 class="card-title text-base">Model</h2>
                @if (_models is not null)
                {
                    <label class="form-control max-w-md">
                        <span class="label-text text-xs mb-1">Active SigLIP model</span>
                        <select class="select select-bordered" value="@_models.ActiveModelId" @onchange="OnModelChanged" disabled="@_busy">
                            @foreach (var model in _models.Models)
                            {
                                <option value="@model.Id">@model.DisplayName (@model.EmbeddingDim)</option>
                            }
                        </select>
                    </label>
                }
            </div>
        </div>

        <div class="flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline btn-sm" disabled="@_busy" @onclick="OptimizeAsync">Optimize indexes</button>
            <button type="button" class="btn btn-outline btn-warning btn-sm" disabled="@_busy" @onclick="ResetIndexesAsync">Reset ZVec indexes</button>
            <button type="button" class="btn btn-outline btn-error btn-sm" disabled="@_busy" @onclick="ResetCatalogAsync">Reset SQL catalog</button>
        </div>
    }
</div>
