@page "/search"
@rendermode InteractiveServer

<div class="search-canvas @(_searched && _hasResults ? "search-canvas--serp" : "search-canvas--home") relative">
    @if (_busy)
    {
        <BusyBlock Visible="true"
                   Message="Searching…"
                   SubMessage="@(_queryModeLabel)"
                   CssClass="search-busy-overlay" />
    }

    @if (!_searched || !_hasResults)
    {
        <div class="mb-8">
            <ZLensBrand ShowBadge="true" CssClass="justify-center flex-col sm:flex-row" />
        </div>
    }

    <div class="w-full flex flex-col items-center @(_searched && _hasResults ? "sticky top-16 z-20 bg-base-100/95 backdrop-blur py-3 -mx-4 px-4 border-b border-base-300/60" : "")">
        <div class="omnibox @(_encoderReady ? "" : "opacity-60")">
            <button type="button" class="omnibox-icon" disabled="@(!_encoderReady || _busy)" @onclick="SearchAsync" title="Search">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
            </button>

            @if (!string.IsNullOrEmpty(_imagePreviewUrl))
            {
                <img src="@_imagePreviewUrl" alt="Lens query" class="w-8 h-8 rounded-lg object-cover shrink-0 border border-base-300" />
                <button type="button" class="btn btn-ghost btn-xs btn-circle shrink-0" @onclick="ClearLens" title="Remove image">✕</button>
            }

            <input class="omnibox-input"
                   placeholder="@(_encoderReady ? "Search fashion products with ZLens…" : "Waiting for SigLIP…")"
                   @bind="_query"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDown"
                   disabled="@(!_encoderReady || _busy)" />

            <button type="button" class="omnibox-icon text-primary" disabled="@(!_encoderReady || _busy)" @onclick="OpenLens" title="Lens camera">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </button>
        </div>

        @if (!_encoderReady && _boot is not null)
        {
            <p class="text-xs text-base-content/50 mt-2 max-w-[680px] text-center">@_boot.Message</p>
        }

        @if (_wowChips.Count > 0 && (!_searched || !_hasResults))
        {
            <div class="flex flex-wrap justify-center gap-2 mt-5 max-w-[680px]">
                @foreach (var chip in _wowChips)
                {
                    <button type="button" class="btn btn-ghost btn-sm rounded-full border border-base-300/80" @onclick="async () => await ApplyChip(chip)">
                        @chip.QueryText
                    </button>
                }
            </div>
        }

        @if (_searched && _hasResults)
        {
            <div class="demo-strip">
                <div class="collapse collapse-arrow bg-base-200/60 border border-base-300 rounded-2xl">
                    <input type="checkbox" />
                    <div class="collapse-title text-sm font-medium py-3 min-h-0">Demo settings</div>
                    <div class="collapse-content text-sm pb-4">
                        <DemoControls @bind-Engine="_engine"
                                      @bind-TopK="_topK"
                                      @bind-Fusion="_fusion"
                                      @bind-MasterCategory="_masterCategory"
                                      @bind-UseInvert="_useInvert"
                                      @bind-UseHybridFts="_useHybridFts"
                                      ShowFusion="@(_engine == VectorEngineMode.ZVec)" />
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!_searched || !_hasResults)
    {
        <div class="demo-strip mt-8 w-full max-w-xl">
            <div class="collapse collapse-arrow bg-base-200/40 border border-base-300/60 rounded-2xl">
                <input type="checkbox" />
                <div class="collapse-title text-sm font-medium py-3 min-h-0">Demo settings</div>
                <div class="collapse-content text-sm pb-4">
                    <DemoControls @bind-Engine="_engine"
                                  @bind-TopK="_topK"
                                  @bind-Fusion="_fusion"
                                  @bind-MasterCategory="_masterCategory"
                                  @bind-UseInvert="_useInvert"
                                  @bind-UseHybridFts="_useHybridFts"
                                  ShowFusion="@(_engine == VectorEngineMode.ZVec)" />
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_searchError))
    {
        <ErrorBanner Title="Search failed" Message="@_searchError" CssClass="w-full max-w-5xl mx-auto mt-6" />
    }

    @if (_response?.Latency is not null && _searched)
    {
        <div class="w-full max-w-5xl mx-auto mt-4 rounded-2xl border border-base-300 bg-base-200/50 p-3 font-mono text-xs text-base-content/70">
            <p class="text-sm font-sans font-semibold text-base-content mb-2">Query timing (ms)</p>
            <div class="flex flex-wrap gap-x-4 gap-y-1">
                @foreach (var chip in BuildTimingChips())
                {
                    <span title="@chip.Tooltip">@chip.Label @chip.Value</span>
                }
                <span class="font-semibold text-base-content" title="Wall clock for the whole request.">Total @FormatMs(_response.Latency.TotalMs)</span>
            </div>
            @if (_response.Compare is not null)
            {
                <p class="mt-2 font-sans text-xs">
                    Overlap at N: @_response.Compare.OverlapAtN shared IDs ·
                    Jaccard @_response.Compare.JaccardAtN.ToString("P0") ·
                    @_response.Compare.RankDisagreements rank disagreements ·
                    ZVec @FormatMs(_response.Compare.ZVecTotalMs) vs Postgres @FormatMs(_response.Compare.PostgreSqlTotalMs)
                </p>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_response?.Warning) && _searched)
    {
        <div role="alert" class="alert alert-warning w-full max-w-5xl mx-auto mt-4 rounded-2xl">
            <span>@_response.Warning</span>
        </div>
    }

    @if (_searched && !_hasResults && string.IsNullOrEmpty(_searchError))
    {
        <EmptyState Icon="🛍️"
                    Title="No results"
                    Message="@(_response?.Warning ?? "Try another query, adjust filters, or ingest more products.")"
                    CssClass="w-full max-w-lg mx-auto mt-8">
            <a href="/ingest" class="btn btn-primary btn-sm">Go to Ingest</a>
        </EmptyState>
    }

    @if (_hasResults)
    {
        <div class="w-full max-w-6xl mx-auto mt-6">
            <div role="tablist" class="tabs tabs-bordered mb-4">
                <button type="button" role="tab" class="tab @(_tab == ResultsTab.All ? "tab-active" : "")" @onclick="() => _tab = ResultsTab.All">All</button>
                <button type="button" role="tab" class="tab @(_tab == ResultsTab.Images ? "tab-active" : "")" @onclick="() => _tab = ResultsTab.Images">Images</button>
            </div>

            @if (_engine == VectorEngineMode.Both)
            {
                <div class="grid lg:grid-cols-2 gap-6">
                    <div>
                        <h2 class="text-sm font-semibold mb-3 text-base-content/70">ZVec</h2>
                        @RenderResultList(_response?.ZVecHits)
                    </div>
                    <div>
                        <h2 class="text-sm font-semibold mb-3 text-base-content/70">PostgreSQL</h2>
                        @RenderResultList(_response?.PostgreSqlHits)
                    </div>
                </div>
            }
            else
            {
                @RenderResultList(_engine == VectorEngineMode.Postgres ? _response?.PostgreSqlHits : _response?.ZVecHits)
            }
        </div>
    }
</div>

<InputFile id="lens-file-input" OnChange="OnLensFileSelected" accept="image/*" class="hidden" />

<div class="modal @(_lensOpen ? "modal-open" : "")">
    <div class="modal-box max-w-lg bg-base-200 border border-base-300 rounded-2xl">
        <h3 class="font-semibold text-lg mb-1">Search with Lens</h3>
        <p class="text-sm text-base-content/60 mb-4">Drop, paste, or upload a photo to find similar products.</p>

        <div @ref="_dropZone" class="lens-dropzone" @onclick="OpenFilePicker">
            @if (!string.IsNullOrEmpty(_lensPreviewUrl))
            {
                <img src="@_lensPreviewUrl" alt="Preview" class="max-h-48 mx-auto rounded-xl mb-4 object-contain" />
                <p class="text-sm text-base-content/70">Click Search with this image</p>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-3 text-primary/70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                <p class="font-medium">Drop image here</p>
                <p class="text-xs text-base-content/50 mt-2">or click to browse · Ctrl+V to paste</p>
            }
        </div>

        <div class="modal-action">
            <button type="button" class="btn btn-ghost" @onclick="CloseLens">Cancel</button>
            <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrEmpty(_pendingImageBase64))" @onclick="ConfirmLens">Search with image</button>
        </div>
    </div>
    <button type="button" class="modal-backdrop" @onclick="CloseLens">close</button>
</div>
