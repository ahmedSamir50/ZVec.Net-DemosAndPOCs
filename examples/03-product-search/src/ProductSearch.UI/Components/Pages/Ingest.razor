@page "/ingest"
@rendermode InteractiveServer
@inject ApiClientService Api
@inject ToastService Toasts

<div class="max-w-3xl mx-auto px-4 py-8 space-y-6">
    <div>
        <h1 class="text-2xl font-semibold">Ingest</h1>
        <p class="text-sm text-base-content/60 mt-1">
            Resume-safe patches over the fashion catalog. Each patch encodes SigLIP vectors,
            upserts ZVec collections, then commits PostgreSQL in one transaction.
        </p>
    </div>

    <div class="card bg-base-200 border border-base-300">
        <div class="card-body gap-4">
            <div>
                <span class="label-text text-xs">Patch size</span>
                <div class="join mt-2">
                    @foreach (var size in new[] { 100, 500, 1000 })
                    {
                        <button type="button"
                                class="btn btn-sm join-item @(_patchSize == size ? "btn-primary" : "btn-outline")"
                                @onclick="() => _patchSize = size">
                            @size
                        </button>
                    }
                </div>
            </div>

            <div class="flex flex-wrap gap-2 items-center">
                <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="RunAsync">
                    @(_busy ? "Running…" : "Start patch")
                </button>
                <button type="button" class="btn btn-outline btn-sm" disabled="@_busy" @onclick="OptimizeAsync">
                    Optimize indexes
                </button>
                <label class="label cursor-pointer gap-2 justify-start">
                    <input type="checkbox" class="toggle toggle-sm toggle-primary" @bind="_optimizeAfterPatch" />
                    <span class="label-text text-xs">Optimize after patch</span>
                </label>
            </div>

            @if (_busy)
            {
                <p class="text-xs text-base-content/60">@_status</p>
                <progress class="progress progress-primary w-full"></progress>
            }
        </div>
    </div>

    @if (_progress is not null)
    {
        <div class="card bg-base-200 border border-base-300">
            <div class="card-body">
                <h2 class="card-title text-base mb-2">Progress</h2>
                <div class="overflow-x-auto">
                    <table class="table table-sm">
                        <tbody>
                            <tr><td>Status</td><td>@_progress.Status</td></tr>
                            <tr><td>Patch size</td><td>@_progress.PatchSize</td></tr>
                            <tr><td>Patch index</td><td>@_progress.PatchIndex</td></tr>
                            <tr><td>Encoded</td><td>@_progress.Encoded</td></tr>
                            <tr><td>ZVec upserted</td><td>@_progress.ZVecUpserted</td></tr>
                            <tr><td>SQL committed</td><td>@_progress.SqlCommitted</td></tr>
                            <tr><td>Ingest offset</td><td>@_progress.IngestOffset</td></tr>
                        </tbody>
                    </table>
                </div>
                @if (!string.IsNullOrEmpty(_progress.ErrorMessage))
                {
                    <div role="alert" class="alert alert-error mt-3 text-sm"><span>@_progress.ErrorMessage</span></div>
                }
            </div>
        </div>
    }
</div>

@code {
    private IngestProgressDto? _progress;
    private bool _busy;
    private string _status = "";
    private int _patchSize = 100;
    private bool _optimizeAfterPatch = true;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _progress = await Api.GetIngestAsync();
        }
        catch (Exception ex)
        {
            Toasts.Show(ex.Message, ToastLevel.Warning);
        }
    }

    private async Task RunAsync()
    {
        _busy = true;
        _status = "Starting patch…";
        await InvokeAsync(StateHasChanged);

        _pollCts = new CancellationTokenSource();
        var pollTask = PollProgressAsync(_pollCts.Token);

        try
        {
            _progress = await Api.StartIngestAsync(new IngestRequestDto
            {
                PatchSize = _patchSize,
                OptimizeAfterPatch = _optimizeAfterPatch
            });
            Toasts.Show($"Patch {_progress?.Status}", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show(ex.Message, ToastLevel.Error);
            _status = ex.Message;
        }
        finally
        {
            await _pollCts.CancelAsync();
            try { await pollTask; } catch (OperationCanceledException) { }
            _pollCts.Dispose();
            _pollCts = null;
            _busy = false;
            _status = "";
            try { _progress = await Api.GetIngestAsync() ?? _progress; }
            catch { /* ignore */ }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OptimizeAsync()
    {
        _busy = true;
        _status = "Optimizing HNSW indexes…";
        try
        {
            await Api.OptimizeIndexAsync();
            Toasts.Show("Optimized — flat buffers merged into HNSW.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            _busy = false;
            _status = "";
        }
    }

    private async Task PollProgressAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                var p = await Api.GetIngestAsync(ct);
                if (p is not null)
                {
                    _progress = p;
                    _status = $"Status: {p.Status} · encoded {p.Encoded} · SQL {p.SqlCommitted}";
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { break; }
            catch { /* transient */ }

            try { await Task.Delay(750, ct); }
            catch (OperationCanceledException) { break; }
        }
    }
}
