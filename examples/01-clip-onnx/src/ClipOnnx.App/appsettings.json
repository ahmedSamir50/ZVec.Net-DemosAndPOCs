{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClipOnnx": {
    "DataRoot": "./data",
    "ModelsDir": "./models",
    "AutoDownloadModels": true,
    "ModelRepo": "inference4j/clip-vit-base-patch32",
    "ModelDownloadUrlTemplate": "https://huggingface.co/inference4j/clip-vit-base-patch32/resolve/main/{file}",
    "VisionModelFile": "vision_model.onnx",
    "TextModelFile": "text_model.onnx",
    "VocabFile": "vocab.json",
    "MergesFile": "merges.txt",
    "CollectionPath": "./data/zvec-clip-gallery",
    "EnableMmap": true,
    "DefaultBatchSize": 100,
    "DefaultTopK": 10,
    "MaxUploadBytes": 8388608
  }
}
