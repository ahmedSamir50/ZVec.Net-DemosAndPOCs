{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClipOnnx": {
    "DataRoot": "./data",
    "ModelsDir": "./models",
    "ActiveModelId": "clip-vit-b16",
    "AutoDownloadModels": true,
    "VisionModelFile": "vision_model.onnx",
    "TextModelFile": "text_model.onnx",
    "VocabFile": "vocab.json",
    "MergesFile": "merges.txt",
    "CollectionPath": "./data/zvec-clip-gallery",
    "EnableMmap": true,
    "DefaultBatchSize": 100,
    "DefaultTopK": 10,
    "MaxUploadBytes": 8388608,
    "TextPromptTemplate": "a photo of {query}",
    "TextPromptTemplates": [ "a photo of {query}" ],
    "MinCosine": 0.30,
    "MaxCosineGapFromTop": 0.05,
    "MinConfidentHits": 3
  }
}
